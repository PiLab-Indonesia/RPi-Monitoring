# Copy to .env for local development (do not commit real secrets).
# Environment variables override values in this file.
APP_NAME=RPi-NMS
ENV=development
DB_PATH=data/rpi_nms.db
DEFAULT_NETWORK=192.168.1.0/24
SCAN_INTERVAL_MINUTES=5

# Set these only when enabling notifications.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# WEBHOOK_URLS=

# Required: replace with a fresh, strong secret before any public deployment.
SECRET_KEY=replace-me-with-secure-random
ACCESS_TOKEN_EXPIRE_MINUTES=60
